# Copy this file to .env and fill in your keys. .env is gitignored.
# Benchmark files are distributed separately. Point this at the directory
# downloaded from or mounted through Drive.
VLM_JAILBREAK_DATA_ROOT=/absolute/path/to/vlm-jailbreak-data

# Used by API-backed components such as the JPS agents and optional HADES
# keyword-type enrichment.
OPENAI_API_KEY=sk-your-key-here
# Optional: override the refiner model / base URL
# OPENAI_BASE_URL=https://api.openai.com/v1
